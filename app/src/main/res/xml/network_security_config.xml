<?xml version="1.0" encoding="utf-8"?>
<!--
    The app talks to two kinds of address, and they are not the same kind.

    The catalogue comes from the site and is always fetched over HTTPS. The
    mirrors are published by third parties, and some of them are still plain
    HTTP: a mirror the browser player can read is a mirror this app has to be
    able to read too, or the channel works on the website and not in the app.

    So cleartext is permitted in general and denied for the addresses that
    carry the app's own traffic — the site and the update manifest — so a
    downgrade of those can never happen.

    The three certificates the app carries are trust anchors of their own.
    They are the roots that were measured to be missing on the televisions
    this app has to run on: a box whose CA bundle was never updated turns
    away the mirrors of several providers, while a browser on a current
    machine does not. They are named here as well as in the repair in
    core/tls/ProviderTls.kt, because the platform's own check and the
    repair's check are two different doors and both have to be open.
-->
<network-security-config>

    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/provider_roots" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">soluplay.vercel.app</domain>
        <domain includeSubdomains="true">raw.githubusercontent.com</domain>
        <domain includeSubdomains="true">github.com</domain>
    </domain-config>

</network-security-config>
